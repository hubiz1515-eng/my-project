rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isSeller() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // users: 본인 문서만. 역할(role)은 가입 시 1회 지정, 이후 변경 불가.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['customer', 'seller'];
      allow update: if isOwner(uid) && unchanged('role') && unchanged('uid');
      allow delete: if false;
    }

    // stores: 누구나 조회, 사장님 본인 매장만 생성/수정.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSeller()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) && unchanged('ownerId');
      allow delete: if false;
    }

    // food_items: 누구나 조회, 소유 매장의 사장님만 등록/수정.
    // 결제 시 재고 차감은 Cloud Function(Admin SDK)이 트랜잭션으로 처리하므로 소비자 쓰기는 없음.
    match /food_items/{itemId} {
      allow read: if true;
      allow create: if isSeller()
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.discountPrice is int
        && request.resource.data.discountPrice > 0
        && request.resource.data.discountPrice <= request.resource.data.originalPrice
        && request.resource.data.status in ['selling', 'paused'];
      allow update: if isOwner(resource.data.ownerId)
        && unchanged('ownerId') && unchanged('storeId')
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.discountPrice <= request.resource.data.originalPrice
        && request.resource.data.status in ['selling', 'sold_out', 'paused'];
      allow delete: if isOwner(resource.data.ownerId);
    }

    // orders: 구매자와 해당 매장 사장님만 조회. 생성/변경은 서버(Cloud Function)만.
    // (결제 검증·재고 차감·핀코드 발급·픽업 확정은 클라이언트를 신뢰할 수 없음)
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.customerId) || isOwner(resource.data.storeOwnerId);
      allow write: if false;
    }
  }
}
