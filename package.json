{
  "name": "pickup-deal",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@portone/browser-sdk": "0.1.13",
    "@portone/react-native-sdk": "0.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "barcode-detector": "3.2.2",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "geofire-common": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/google.maps": "^3.66.5",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-pickupdeal \"node --test tests/firestore.rules.test.mjs\"",
    "emulators": "npm --prefix functions run build && npx --yes firebase-tools emulators:start --project demo-pickupdeal",
    "test:functions": "node functions/test/run.mjs",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore",
    "deploy:functions": "npx --yes firebase-tools deploy --only functions",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-emulator.mjs"
  },
  "private": true
}
