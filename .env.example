# 복사해서 `.env` 로 저장 후 값을 채우세요. (`.env` 는 .gitignore 처리됨)
# Expo는 `EXPO_PUBLIC_` 접두사가 붙은 변수만 앱 번들에 포함합니다.
# ⚠️ 번들에 들어간 값은 누구나 읽을 수 있습니다. 비밀키(서버 시크릿)는 절대 여기에 넣지 마세요.

# ── Firebase (콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 SDK 구성) ──────────────
# 웹 앱 키는 공개 식별자이며, 실제 보호는 firestore.rules 가 담당합니다.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# 선택: Google Analytics 측정 ID (RN 에서는 현재 미사용)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Kakao (developers.kakao.com > 내 애플리케이션 > 앱 키) ────────────────
# 지도 표시(WebView 내 JavaScript SDK)용 JavaScript 키. 플랫폼 > Web 에 도메인 등록 필요.
EXPO_PUBLIC_KAKAO_JS_KEY=
# 주소→좌표 변환(REST API)용 키. 사장님 매장 등록 시 클라이언트에서 호출하는 경우에만 사용.
# 노출 위험이 있으므로 가능하면 Cloud Function 으로 옮기는 것을 권장합니다.
EXPO_PUBLIC_KAKAO_REST_KEY=

# ── PortOne (콘솔 > 결제연동 > 연동 정보) ─────────────────────────────────
# 클라이언트에는 '가맹점 식별코드/스토어 ID/채널 키' 같은 공개 값만 둡니다.
# API Secret / Webhook Secret 은 Cloud Functions 환경변수(Secret Manager)에만 저장하세요.
EXPO_PUBLIC_PORTONE_STORE_ID=
EXPO_PUBLIC_PORTONE_CHANNEL_KEY_TOSS=
EXPO_PUBLIC_PORTONE_CHANNEL_KEY_KAKAOPAY=
