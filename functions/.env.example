# functions/.env 로 복사해 사용 (배포 시 함께 올라감 — 비밀값은 넣지 말 것)
# PortOne 상점 ID (콘솔 > 결제연동 > 연동 정보). 결제 조회 시 다른 상점 결제를 거부하는 데 사용.
PORTONE_STORE_ID=

# 비밀값은 .env 가 아니라 Secret Manager 에 저장:
#   npx firebase-tools functions:secrets:set PORTONE_API_SECRET
#   npx firebase-tools functions:secrets:set PORTONE_WEBHOOK_SECRET
# 로컬 에뮬레이터에서 실결제 검증을 하려면 functions/.secret.local 에 같은 이름으로 (gitignore 됨)
