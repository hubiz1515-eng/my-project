{
  "expo": {
    "name": "푸드 클럽",
    "slug": "pickup-deal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodclub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.foodclub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "foodclub",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 마감 할인 매장을 보여주기 위해 현재 위치를 사용합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "손님의 픽업 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "recordAudioAndroid": false
        }
      ],
      "@portone/react-native-sdk/plugin",
      [
        "expo-notifications",
        {
          "color": "#16a34a",
          "defaultChannel": "orders"
        }
      ]
    ]
  }
}
